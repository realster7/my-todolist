{
  "openapi": "3.0.3",
  "info": {
    "title": "TodoList API",
    "version": "0.1.0",
    "description": "인증된 사용자별 할일(Todo)/카테고리(Category) 관리 API. 도메인 정의서(1-domain-definition.md v0.4.0), PRD(2-PRD.md v0.2.0), 실행계획(8-pan.md BE-03~BE-10)을 근거로 작성됨."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "로컬 개발 서버" }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "회원가입/로그인/토큰 재발급 (UC-01, UC-02)"
    },
    { "name": "Categories", "description": "카테고리 조회 (UC-09)" },
    {
      "name": "Todos",
      "description": "할일 등록/조회/필터링/수정/삭제 (UC-04~08)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "access_token을 Authorization 헤더에 `Bearer <token>` 형식으로 전달 (BR-01)"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "description": "응답용 사용자 정보 (password 제외)",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "email", "name", "createdAt", "updatedAt"]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "name": {
            "type": "string",
            "maxLength": 50,
            "description": "사용자별 고유. 기본값 '기본' (BR-04)"
          },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "userId", "name", "createdAt"]
      },
      "TodoStatus": {
        "type": "string",
        "description": "조회 시점 계산값 (BR-06, 도메인정의서 5장). 완료 여부 최우선 판별.",
        "enum": ["NOT_STARTED", "IN_PROGRESS", "DONE", "OVERDUE"]
      },
      "Todo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "categoryId": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "nullable": true },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "isDone": { "type": "boolean" },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "isDone=true 시 설정, 완료 취소 시 null로 초기화 (BR-07)"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "userId",
          "categoryId",
          "title",
          "startDate",
          "endDate",
          "isDone",
          "createdAt",
          "updatedAt"
        ]
      },
      "TodoWithStatus": {
        "allOf": [
          { "$ref": "#/components/schemas/Todo" },
          {
            "type": "object",
            "properties": {
              "status": { "$ref": "#/components/schemas/TodoStatus" }
            },
            "required": ["status"]
          }
        ]
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "required": ["email", "password", "name"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        },
        "required": ["email", "password"]
      },
      "LoginResponse": {
        "type": "object",
        "description": "access_token은 응답 바디로 반환, refresh_token은 httpOnly 쿠키로 전달됨 (PRD 6·7장)",
        "properties": {
          "accessToken": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        },
        "required": ["accessToken", "user"]
      },
      "RefreshResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" }
        },
        "required": ["accessToken"]
      },
      "CreateTodoRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "nullable": true },
          "startDate": { "type": "string", "format": "date" },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "startDate 이상이어야 함 (BR-05)"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "미지정 시 사용자 '기본' 카테고리로 자동 지정 (BR-04)"
          }
        },
        "required": ["title", "startDate", "endDate"]
      },
      "UpdateTodoRequest": {
        "type": "object",
        "description": "부분 수정. 전달된 필드만 갱신됨 (UC-07)",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "nullable": true },
          "startDate": { "type": "string", "format": "date" },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "startDate 이상이어야 함 (BR-05)"
          },
          "categoryId": { "type": "string", "format": "uuid" },
          "isDone": {
            "type": "boolean",
            "description": "true 전환 시 completedAt 기록, false 전환 시 completedAt 초기화 (BR-07)"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_ERROR" },
              "message": {
                "type": "string",
                "example": "요청 값이 올바르지 않습니다."
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "요청 검증 실패 (예: endDate < startDate, BR-05)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "인증되지 않음 (access_token 없음/무효/만료, BR-01)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "본인 소유가 아닌 리소스에 접근 (BR-02)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "리소스가 존재하지 않음 (또는 소유권 위반을 404로 표현하는 정책 적용 시, BR-02)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Conflict": {
        "description": "리소스 중복 (예: 이미 가입된 email, BR-03)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "회원가입 (UC-01)",
        "description": "email/password/name으로 계정을 생성한다. 가입 시 해당 사용자의 '기본' 카테고리가 자동 생성된다 (BR-04).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "계정 생성됨",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인 (UC-02)",
        "description": "email/password 검증 후 JWT access_token(응답 바디)과 refresh_token(httpOnly 쿠키)을 발급한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "headers": {
              "Set-Cookie": {
                "description": "refresh_token (httpOnly)",
                "schema": {
                  "type": "string",
                  "example": "refresh_token=<jwt>; HttpOnly; Path=/; SameSite=Strict"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "access_token 재발급 (BR-01)",
        "description": "쿠키로 전달된 refresh_token을 검증해 새 access_token을 발급한다. refresh_token이 만료/무효인 경우 재로그인이 필요하다.",
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RefreshResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "카테고리 목록 조회 (UC-09)",
        "description": "인증된 사용자 본인 소유 카테고리만 반환한다 (BR-02).",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "카테고리 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Category" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/todos": {
      "post": {
        "tags": ["Todos"],
        "summary": "할일 등록 (UC-04)",
        "description": "제목/기간(시작일·종료일)/카테고리(선택)를 입력받아 할일을 등록한다. categoryId 미지정 시 '기본' 카테고리로 자동 지정 (BR-04). endDate는 startDate 이상이어야 함 (BR-05).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTodoRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "할일 생성됨",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Todo" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "get": {
        "tags": ["Todos"],
        "summary": "할일 목록 조회/필터링 (UC-05, UC-06)",
        "description": "본인 소유 할일만 반환하며 (BR-02), 각 항목에 도메인정의서 5장 규칙으로 계산된 status를 포함한다 (BR-06). 완료된 할일은 종료일이 지났어도 OVERDUE가 아닌 DONE으로 반환된다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "카테고리 id로 필터링",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "계산된 상태로 필터링",
            "required": false,
            "schema": { "$ref": "#/components/schemas/TodoStatus" }
          }
        ],
        "responses": {
          "200": {
            "description": "할일 목록 (status 포함)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/TodoWithStatus" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/todos/{id}": {
      "patch": {
        "tags": ["Todos"],
        "summary": "할일 수정 (UC-07)",
        "description": "본인 소유 할일만 수정 가능 (BR-02). endDate < startDate이면 거부 (BR-05). isDone false→true 전환 시 completedAt 기록, true→false 전환 시 completedAt 초기화 (BR-07).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTodoRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정된 할일",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Todo" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Todos"],
        "summary": "할일 삭제 (UC-08)",
        "description": "본인 소유 할일만 삭제 가능 (BR-02).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": { "description": "삭제됨" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  }
}
